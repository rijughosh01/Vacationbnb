<% layout("/layouts/boilerplate") %>

<!-- 1. Master Hero Section -->
<section class="home-hero-container my-3 my-md-4">
  <div class="home-hero-card position-relative overflow-hidden rounded-5 text-white p-4 p-md-5 d-flex flex-column justify-content-center align-items-center text-center shadow-lg">
    <!-- Background Overlay Backdrop -->
    <div class="home-hero-backdrop"></div>

    <div class="home-hero-content position-relative z-2 w-100" style="max-width: 960px;">
      <!-- Welcome Pill -->
      <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill hero-pill mb-3">
        <i class="fa-solid fa-sparkles text-warning"></i>
        <span class="small fw-semibold tracking-wide">WanderLust Premier Vacation Homes</span>
      </div>

      <!-- Main Headline -->
      <h1 class="display-4 fw-bolder tracking-tight mb-3 hero-title">
        Find your sanctuary.<br class="d-none d-sm-inline" />
        <span class="hero-gradient-text">Travel without limits.</span>
      </h1>

      <!-- Subtitle -->
      <p class="lead hero-subtext mb-4 mx-auto" style="max-width: 660px;">
        Curated beachfront villas, cliffside infinity pools, alpine retreats, and historic châteaux across 120+ destinations worldwide.
      </p>

      <!-- Multi-Field Floating Search Capsule -->
      <div class="hero-search-box mx-auto mb-4 p-2 p-md-3 rounded-pill bg-white shadow-lg text-dark">
        <form action="/listings" method="GET" class="row g-2 align-items-center m-0 w-100">
          <!-- Where Input -->
          <div class="col-12 col-md-4 text-start px-3 py-1 border-end-md">
            <label class="d-block text-uppercase text-muted fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Where to?</label>
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-location-dot text-danger"></i>
              <input 
                type="text" 
                name="q" 
                class="form-control form-control-sm border-0 p-0 fw-semibold bg-transparent shadow-none" 
                placeholder="Search destinations (e.g. Goa, Paris)..."
              />
            </div>
          </div>

          <!-- Category Select -->
          <div class="col-12 col-md-4 text-start px-3 py-1 border-end-md">
            <label class="d-block text-uppercase text-muted fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Experience</label>
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-compass text-primary"></i>
              <select name="category" class="form-select form-select-sm border-0 p-0 fw-semibold bg-transparent shadow-none">
                <option value="All">All Categories</option>
                <option value="Trending">Trending</option>
                <option value="Beachfront">Beachfront</option>
                <option value="Amazing Pools">Amazing Pools</option>
                <option value="Mountains">Mountains</option>
                <option value="Castles">Castles</option>
                <option value="Iconic cities">Iconic Cities</option>
                <option value="Camping">Camping</option>
                <option value="Farms">Farms</option>
                <option value="Arctic">Arctic</option>
              </select>
            </div>
          </div>

          <!-- Search CTA Button -->
          <div class="col-12 col-md-4 text-md-end text-center p-1">
            <button type="submit" class="btn btn-luxury-primary w-100 rounded-pill py-2 px-4 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm">
              <i class="fa-solid fa-magnifying-glass"></i>
              <span>Explore Stays</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Quick Destination Shortcut Pills -->
      <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap hero-dest-pills">
        <span class="small text-white-50 me-1 fw-semibold">Popular:</span>
        <a href="/listings?q=Goa" class="badge rounded-pill hero-tag-pill text-decoration-none">🌴 Goa</a>
        <a href="/listings?q=Paris" class="badge rounded-pill hero-tag-pill text-decoration-none">🗼 Paris</a>
        <a href="/listings?q=Malibu" class="badge rounded-pill hero-tag-pill text-decoration-none">🌊 Malibu</a>
        <a href="/listings?q=Aspen" class="badge rounded-pill hero-tag-pill text-decoration-none">🏔️ Aspen</a>
        <a href="/listings?q=Florence" class="badge rounded-pill hero-tag-pill text-decoration-none">🏛️ Florence</a>
        <a href="/listings?q=Tokyo" class="badge rounded-pill hero-tag-pill text-decoration-none">🏯 Tokyo</a>
        <a href="/listings?q=Bali" class="badge rounded-pill hero-tag-pill text-decoration-none">🏝️ Bali</a>
      </div>
    </div>

    <!-- Trust Stats Bar -->
    <div class="home-hero-stats position-relative z-2 w-100 mt-4 pt-3 border-top border-white border-opacity-10 d-none d-md-flex align-items-center justify-content-around">
      <div class="d-flex align-items-center gap-2 text-white-50 small">
        <i class="fa-solid fa-star text-warning"></i>
        <span><strong class="text-white">4.92 / 5</strong> Average Guest Rating</span>
      </div>
      <div class="d-flex align-items-center gap-2 text-white-50 small">
        <i class="fa-solid fa-shield-halved text-success"></i>
        <span><strong class="text-white">₹10,00,000</strong> WanderCover Included</span>
      </div>
      <div class="d-flex align-items-center gap-2 text-white-50 small">
        <i class="fa-solid fa-certificate text-info"></i>
        <span><strong class="text-white">100%</strong> Verified Luxury Homes</span>
      </div>
    </div>
  </div>
</section>

