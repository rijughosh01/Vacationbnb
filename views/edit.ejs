<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-lg-8 offset-lg-2">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square text-danger me-2"></i>Edit Listing</h2>
          <p class="text-muted">Update the information or photo for your property.</p>
        </div>
        <a href="/listings/<%= listing._id %>" class="btn btn-outline-dark rounded-pill px-3">Cancel</a>
      </div>

      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input 
            name="listing[title]" 
            id="title"
            value="<%= listing.title %>" 
            type="text" 
            class="form-control form-control-luxury" 
            required 
          />
          <div class="invalid-feedback">Please enter a valid title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea 
            name="listing[description]" 
            id="description"
            rows="4" 
            class="form-control form-control-luxury" 
            required
          ><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description.</div>
        </div>

        <!-- Category & Price -->
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label for="category" class="form-label fw-semibold">Property Category</label>
            <select name="listing[category]" id="category" class="form-select form-control-luxury" required>
              <% const categories = ["Trending", "Rooms", "Iconic cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Beachfront", "Luxury"]; %>
              <% for(let cat of categories) { %>
                <option value="<%= cat %>" <%= listing.category === cat ? "selected" : "" %>><%= cat %></option>
              <% } %>
            </select>
          </div>

          <div class="col-md-6">
            <label for="price" class="form-label fw-semibold">Nightly Price (&#8377; INR)</label>
            <div class="input-group">
              <span class="input-group-text bg-white border-end-0">&#8377;</span>
              <input 
                name="listing[price]" 
                id="price"
                value="<%= listing.price %>" 
                type="number" 
                min="1" 
                class="form-control form-control-luxury border-start-0" 
                required 
              />
            </div>
          </div>
        </div>

        <!-- Current Image Preview -->
        <div class="mb-3 p-3 bg-light rounded-3 d-flex align-items-center gap-3">
          <img src="<%= originalImageUrl %>" alt="Current image" class="rounded-3 shadow-xs" style="width: 120px; height: 80px; object-fit: cover;" />
          <div>
            <span class="d-block fw-semibold small text-dark">Current Cover Photo</span>
            <span class="text-muted small">Upload a new photo below if you wish to change it.</span>
          </div>
        </div>

        <!-- Upload New Image -->
        <div class="mb-3">
          <label for="images" class="form-label fw-semibold">Add / Replace Photos (Up to 5)</label>
          <input 
            name="listing[images]" 
            id="images"
            type="file" 
            class="form-control form-control-luxury" 
            accept="image/*"
            multiple
          />
        </div>

        <!-- Location & Country -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label for="location" class="form-label fw-semibold">City / Location</label>
            <input 
              name="listing[location]" 
              id="location"
              value="<%= listing.location %>" 
              type="text" 
              class="form-control form-control-luxury" 
              required 
            />
          </div>

          <div class="col-md-6">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input 
              name="listing[country]" 
              id="country"
              value="<%= listing.country %>" 
              type="text" 
              class="form-control form-control-luxury" 
              required 
            />
          </div>
        </div>

        <button class="btn btn-luxury-primary py-3 rounded-pill fw-bold fs-5">
          <i class="fa-solid fa-check me-2"></i>Save Changes
        </button>
      </form>
    </div>
  </div>
</div>
