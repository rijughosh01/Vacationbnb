<% layout("/layouts/boilerplate") %>
<div class="row mt-3 mt-md-4 mb-5">
  <div class="col-lg-8 offset-lg-2">
    <div class="card shadow-sm border-0 p-3 p-sm-4 p-md-5 rounded-4">
      <h2 class="fw-bold mb-3"><i class="fa-solid fa-shield-halved text-danger me-2"></i>Privacy Policy</h2>
      <p class="text-muted">Last updated: November 2026</p>
      <hr />
      
      <h5 class="fw-semibold mt-4">1. Information We Collect</h5>
      <p class="text-secondary">We collect information you provide directly to us when creating an account, updating your profile, listing a property, or leaving a review. This includes your name, email address, property details, and uploaded media.</p>
      
      <h5 class="fw-semibold mt-4">2. How We Use Your Information</h5>
      <p class="text-secondary">We use your information to operate, provide, and improve WanderLust, including connecting guests with hosts, processing property listings, and personalizing your travel recommendations.</p>
      
      <h5 class="fw-semibold mt-4">3. Data Protection</h5>
      <p class="text-secondary">Your passwords and personal authentication tokens are hashed using industry-standard cryptography. We never sell your personal information to third parties.</p>
      
      <a href="/listings" class="btn btn-outline-dark rounded-pill mt-4 px-4">Back to Explore</a>
    </div>
  </div>
</div>

