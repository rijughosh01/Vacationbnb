<!-- 3. Featured Top-Rated Stays (Live MongoDB Showcase) -->
<% if (featuredListings && featuredListings.length > 0) { %>
  <section class="my-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-4">
      <div>
        <span class="text-uppercase text-danger fw-bold small tracking-wider">Top Rated Escapes</span>
        <h2 class="h3 fw-bold mb-1">Featured Premier Stays</h2>
        <p class="text-muted mb-0 small">Handpicked homes with verified luxury standards & top host reviews.</p>
      </div>
      <a href="/listings" class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-semibold">
        Explore All <%= totalListingsCount || '40+' %> Stays &rarr;
      </a>
    </div>

    <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
      <% for (let listing of featuredListings) { %>
        <% if (listing) { %>
          <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-card-link text-decoration-none text-dark">
              <div class="card luxury-card h-100 border-0 shadow-sm position-relative">
                <!-- Image Showcase -->
                <div class="card-img-wrapper position-relative overflow-hidden rounded-4">
                  <img 
                    src="<%= listing.image && listing.image.url ? listing.image.url : (listing.images && listing.images.length ? listing.images[0].url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=60') %>" 
                    alt="<%= listing.title %>"
                    loading="lazy"
                    class="w-100 object-fit-cover"
                    style="height: 250px;"
                  />
                  <span class="card-category-badge"><%= listing.category || 'Trending' %></span>
                  
                  <% 
                    const isSaved = currUser && currUser.wishlist && currUser.wishlist.some(item => (item && item._id ? item._id.toString() : item ? item.toString() : '') === listing._id.toString());
                  %>
                  <button 
                    class="card-heart-btn <%= isSaved ? 'active' : '' %>" 
                    type="button" 
                    title="<%= isSaved ? 'Remove from wishlist' : 'Save to wishlist' %>"
                    onclick="toggleWishlist(event, '<%= listing._id %>')"
                  >
                    <i class="<%= isSaved ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                  </button>
                </div>

                <!-- Card Details -->
                <div class="card-info pt-3">
                  <div class="card-title-row d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold text-truncate me-2 fs-6"><%= listing.title %></span>
                    <span class="fw-normal small text-nowrap"><i class="fa-solid fa-star text-warning me-1"></i>4.92</span>
                  </div>
                  <div class="card-location-sub text-muted small text-truncate mb-2">
                    <i class="fa-solid fa-location-dot me-1 text-secondary"></i>
                    <%= listing.location %>, <%= listing.country %>
                  </div>
                  <div class="card-price-row d-flex align-items-center justify-content-between pt-1 border-top">
                    <div>
                      <span class="fw-bold fs-6 text-dark">&#8377;<%= Number(listing.price).toLocaleString("en-IN") %></span>
                      <span class="text-muted small"> / night</span>
                    </div>
                    <span class="badge rounded-pill bg-light text-secondary border px-2 py-1 small">
                      Reserve &rarr;
                    </span>
                  </div>
                </div>
              </div>
            </a>
          </div>
        <% } %>
      <% } %>
    </div>

    <!-- Center Call-To-Action -->
    <div class="text-center mt-5">
      <a href="/listings" class="btn btn-luxury-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-sm">
        <i class="fa-solid fa-compass me-2"></i>Browse All <%= totalListingsCount || '40+' %> Stays
      </a>
    </div>
  </section>
<% } %>

